# Newsletter signup (lib/newsletter.ts, app/api/newsletter/route.ts).
# Without RESEND_API_KEY the form returns an error to the user (it does not
# throw); the rest of the site works fine without it.
RESEND_API_KEY=
# Verified sender address used for new-subscriber welcome emails. If unset,
# signups still succeed but no welcome email is sent.
RESEND_FROM_EMAIL=
# Optional. Only needed if your Resend workspace uses the older,
# audience-scoped contacts model instead of the global Contacts API.
RESEND_AUDIENCE_ID=

# Optional. Public origin used for canonical URLs, the sitemap, robots.txt,
# JSON-LD, and share-image URLs (lib/site.ts). On Vercel it is inferred from
# VERCEL_PROJECT_PRODUCTION_URL; locally it defaults to http://localhost:3000.
# Set it when hosting elsewhere, e.g. https://techcoder.tech
NEXT_PUBLIC_SITE_URL=

# Optional. Re-enables /keystatic and /api/keystatic/* in a production build
# (`next build && next start`) so you can exercise it locally. Never set this
# on a real deployment — storage is `local`, so it would expose an
# unauthenticated filesystem write API. See docs/keystatic.md.
ENABLE_KEYSTATIC=
